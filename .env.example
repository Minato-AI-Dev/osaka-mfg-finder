# ---- 環境変数の設定例 ----
# コピーして .env を作成してください（.env はGitに含めないこと）

# SQLite の保存先（必須）
DATABASE_URL="file:./dev.db"

# OpenAI APIキー（任意）
# 未設定でもCSV登録・閲覧・キーワード検索は動きます。
# 未設定の場合、AIマッチング（意味検索・LLM分析）は無効になり、画面にその旨が表示されます。
# このキーはサーバー側でのみ使用し、ブラウザには送信しません。
OPENAI_API_KEY=

# 使用モデル（任意。既定値を使う場合は未設定で可）
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
